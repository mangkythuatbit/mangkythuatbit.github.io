RewriteEngine On

# ===================================
# 0. BỎ QUA HOÀN TOÀN Config & admin_solve
# (GIỮ NGUYÊN .php – KHÔNG rewrite)
# ===================================
RewriteRule ^Config(/.*)?$ - [L,NC]
RewriteRule ^admin/admin_solve(/.*)?$ - [L,NC]

# ===================================
# 1. ÉP MỌI .html / .php (KỂ CẢ VIẾT HOA) → URL KHÔNG ĐUÔI
# ===================================
RewriteCond %{THE_REQUEST} \s/+(.+?)\.(html|php)[\s?] [NC]
RewriteRule ^ %1 [R=301,L]


# ===============================
# 2. Nếu URL không đuôi, ưu tiên .php
# ===============================
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]


# ===============================
# 3. Nếu không có .php thì dùng .html
# ===============================
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
